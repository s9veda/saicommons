# Only for Expo started with src/web as its project directory; the standard
# scripts use src/.env instead. Do not put server secrets in either file.
# API base URL without /v1. Web can leave it empty to use the current origin;
# native apps require a URL reachable from the device. Use HTTPS for deployments.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Value (not client=) of the matching API_KEYS entry, e.g. admin-web. This is
# embedded in the app bundle and is not a secret.
EXPO_PUBLIC_API_KEY=replace-with-the-admin-web-client-key
