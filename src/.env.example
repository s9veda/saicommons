# Copy to src/.env for the Expo app started from src/; do not put server secrets here.
# API base URL without /v1, reachable from the simulator or device. localhost
# refers to the device. Web can leave it empty to use the current origin;
# native apps require a URL. Use HTTPS for deployed services.
EXPO_PUBLIC_API_URL=https://your-api.example.org
# Value (not client=) of the matching API_KEYS entry for this platform.
# EXPO_PUBLIC_* values are embedded in the bundle and are not secrets.
EXPO_PUBLIC_API_KEY=replace-with-client-key
